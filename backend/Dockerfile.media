FROM bluenviron/mediamtx:1.9.1 AS media
FROM python:3.12-slim
RUN --mount=type=cache,target=/var/cache/apt --mount=type=cache,target=/var/lib/apt/lists apt-get update && apt-get install -y --no-install-recommends ffmpeg
COPY --from=media /mediamtx /mediamtx
COPY media/mediamtx.yml /mediamtx.yml
COPY media/record_hook.py /record_hook.py
COPY media/compositor.py /compositor.py
EXPOSE 1935 8888 8889 8189 9997
ENTRYPOINT ["python", "/compositor.py"]
