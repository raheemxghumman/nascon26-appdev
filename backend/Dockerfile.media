FROM bluenviron/mediamtx:1.9.1-ffmpeg
RUN apk add --no-cache python3 && ln -s /usr/bin/python3 /usr/local/bin/python
COPY media/mediamtx.yml /mediamtx.yml
COPY media/record_hook.py /record_hook.py
COPY media/compositor.py /compositor.py
EXPOSE 1935 8888 8889 8189 9997
ENTRYPOINT ["python", "/compositor.py"]
